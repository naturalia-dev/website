---
// src/views/Success.astro
import Layout from '../layouts/Layout.astro';
import { localizePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang).success;
---

<Layout title={text.title} noindex>
    <main class="bg-base-50 min-h-screen flex items-center justify-center text-center px-6">
        <div class="max-w-2xl space-y-8 animate-in fade-in zoom-in duration-700">
            
            <div class="w-20 h-20 border border-accent-500 rounded-full flex items-center justify-center mx-auto text-accent-500 mb-8">
                <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
                </svg>
            </div>

            <h1 class="text-4xl md:text-5xl text-text-main font-semibold uppercase tracking-widest">
                {text.heading}
            </h1>
            
            <p class="text-text-body font-light text-lg" set:html={text.text} />

            <div class="pt-8">
                <a href={localizePath('/', lang)} class="inline-block px-10 py-4 bg-white border border-base-300 text-text-main font-bold uppercase tracking-widest text-xs hover:border-accent-500 hover:text-accent-500 transition-all duration-300">
                    {text.back}
                </a>
            </div>

        </div>
    </main>
</Layout>