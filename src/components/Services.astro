---
// src/components/Services.astro
import { Icon } from 'astro-icon/components';

// Define the interface for the props to ensure type safety
interface Props {
  header: {
    badge: string;
    title: string;
    subtitle: string;
    description: string;
  };
  steps: {
    title: string;
    subtitle: string;
    description: string;
    icon: string;
  }[];
}

const { header, steps } = Astro.props;
---

<section id="services" class="py-24 bg-base-100 relative overflow-hidden border-t border-base-200">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-20 items-end">
        <div>
            <span class="text-accent-500 text-[10px] font-bold tracking-[0.2em] uppercase mb-4 block">
                {header.badge}
            </span>
            <h2 class="text-3xl md:text-5xl text-text-main leading-tight font-bold uppercase tracking-widest">
                <span set:html={header.title} /> <br />
                <span class="text-accent-500">{header.subtitle}</span>
            </h2>
        </div>
        <div class="pb-2">
            <p class="text-text-body font-light leading-relaxed max-w-md normal-case border-l border-accent-300 pl-6">
                {header.description}
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-base-200 border border-base-200">
      {steps.map((step) => (
        <div class="group relative p-10 bg-white hover:bg-base-50 transition-colors duration-500">
          
          <div class="mb-6 text-accent-500 group-hover:text-text-main transition-colors duration-300 transform group-hover:-translate-y-1">
            <Icon name={step.icon} class="w-8 h-8 stroke-[1.5]" />
          </div>

          <span class="block text-[10px] font-bold text-text-muted group-hover:text-accent-500 uppercase tracking-widest mb-3 transition-colors">
            {step.subtitle}
          </span>
          
          <h4 class="text-xl text-text-main mb-4 font-semibold uppercase tracking-widest">
            {step.title}
          </h4>
          
          <p class="text-text-muted leading-relaxed font-light text-sm group-hover:text-text-body transition-colors normal-case">
            {step.description}
          </p>

          <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-accent-300 group-hover:w-full transition-all duration-500 ease-out"></div>
        </div>
      ))}
    </div>

  </div>
</section>