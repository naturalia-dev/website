---
// src/layouts/Layout.astro
// Self-hosted variable Hanken Grotesk (normal only: italics are synthesized)
import '@fontsource-variable/hanken-grotesk/wght.css';
import fontLatin from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ogSource from '../assets/images/og-default.png';
import { getLang, localizePath, t } from '../i18n';

interface Props {
	title: string;
	description?: string;
	/** Keep the page out of search results (e.g. form confirmation pages) */
	noindex?: boolean;
	/** Social preview of this page (default: logo card) */
	ogImage?: { src: ImageMetadata; alt: string };
	/** Extra JSON-LD for this page (e.g. a product) */
	schema?: Record<string, unknown>;
}

const { title, noindex = false, schema } = Astro.props;
const currentPath = Astro.url.pathname;

const lang = getLang(Astro.url);
const isEnglish = lang === 'en';
const text = t(lang).layout;

const description = Astro.props.description ?? text.description;

// Navigation Links - Server Side Calculation (Will update on page change)
// Trailing slash matches the deployed URLs (Netlify 301-redirects /page to /page/)
const navLinks = ([
    ['products', 'products'],
    ['contact', 'contact'],
] as const).map(([page, path]) => ({
    label: text.nav[page],
    href: localizePath(`/${path}/`, lang),
}));

// Same page in both languages: "/x/" <-> "/en/x/", home is "/" <-> "/en/"
const withSlash = (path: string) => path.endsWith('/') ? path : `${path}/`;
const basePath = withSlash(currentPath.replace(/^\/en(?=\/|$)/, ''));
const itPath = basePath;
const enPath = localizePath(basePath, 'en');
const langSwitchLink = isEnglish ? itPath : enPath;

const canonicalURL = new URL(isEnglish ? enPath : itPath, Astro.site);
const itURL = new URL(itPath, Astro.site);
const enURL = new URL(enPath, Astro.site);

// Social preview cropped to the 1.91:1 card ratio, 1200x630 at most (small photos are never upscaled);
// the business keeps the logo card. Product photos are framed on the product: centered crop.
const ogCard = async (src: ImageMetadata, position: 'attention' | 'center') => {
    const width = Math.min(1200, src.width, Math.round(src.height * 1200 / 630));
    const height = Math.round(width * 630 / 1200);
    const image = await getImage({ src, width, height, fit: 'cover', position, format: 'jpg', quality: 80 });
    return { url: new URL(image.src, Astro.site), width, height };
};
const defaultOg = await ogCard(ogSource, 'center');
const og = Astro.props.ogImage ? await ogCard(Astro.props.ogImage.src, 'center') : defaultOg;
const ogImageAlt = Astro.props.ogImage?.alt ?? text.ogImageAlt;

const businessSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${Astro.site}#business`,
    name: "Naturalia srl",
    url: Astro.site?.href,
    logo: new URL('/brand/naturalia-vertical.svg', Astro.site).href,
    image: defaultOg.url.href,
    description,
    address: {
        "@type": "PostalAddress",
        streetAddress: "Via Luciano Manara 17",
        addressLocality: "Milano",
        addressRegion: "MI",
        postalCode: "20212",
        addressCountry: "IT",
    },
    vatID: "IT03350540963",
};
const langSwitchLabel = isEnglish ? "IT" : "EN";

// Active link: current page or one of its sub-pages
const isActive = (href: string) => withSlash(currentPath).startsWith(href);

const menuLabels = text.menu;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex" />}

        <link rel="canonical" href={canonicalURL} />
        {!noindex && (
            <>
                <link rel="alternate" hreflang="it" href={itURL} />
                <link rel="alternate" hreflang="en" href={enURL} />
                <link rel="alternate" hreflang="x-default" href={itURL} />
            </>
        )}

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Naturalia" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:locale" content={isEnglish ? "en_US" : "it_IT"} />
        <meta property="og:locale:alternate" content={isEnglish ? "it_IT" : "en_US"} />
        <meta property="og:image" content={og.url} />
        <meta property="og:image:width" content={String(og.width)} />
        <meta property="og:image:height" content={String(og.height)} />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />

        <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
        {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
        
        <ClientRouter />
        
        <!-- Latin subset covers IT/EN text: fetched with the HTML instead of after the CSS -->
        <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
	</head>
    <body class="bg-base-50 text-text-body antialiased selection:bg-accent-500 selection:text-white">
        
        <header 
            transition:name="header"
            class="fixed top-0 left-0 w-full z-50 px-6 py-4 flex justify-between items-center bg-white/80 backdrop-blur-md border-b border-base-200"
        >
            <a href={localizePath('/', lang)} class="block transition-opacity hover:opacity-75">
                <img src="/brand/naturalia-horizontal.svg" alt={text.logoAlt} width="489" height="182" class="h-10 w-auto" />
            </a>

            <nav class="hidden md:flex items-center gap-8">
                {navLinks.map(link => (
                    <a 
                        href={link.href} 
                        aria-current={isActive(link.href) ? 'page' : undefined}
                        class={`text-xs font-bold uppercase tracking-widest transition-colors ${
                            isActive(link.href) ? 'text-accent-500' : 'text-text-main hover:text-accent-500'
                        }`}
                    >
                        {link.label}
                    </a>
                ))}
            </nav>

            <div class="flex items-center gap-5">
                <a href={langSwitchLink} class="text-xs font-bold text-accent-500 hover:text-text-main uppercase tracking-widest border border-accent-500 px-2 py-1 rounded-sm transition-colors">
                    {langSwitchLabel}
                </a>

                <button
                    type="button"
                    id="menu-toggle"
                    class="md:hidden group relative w-7 h-5 cursor-pointer"
                    aria-controls="mobile-menu"
                    aria-expanded="false"
                    aria-label={menuLabels.open}
                    data-label-open={menuLabels.open}
                    data-label-close={menuLabels.close}
                >
                    <span class="absolute left-0 top-1 h-px w-full bg-text-main transition-transform duration-300 group-aria-expanded:top-1/2 group-aria-expanded:rotate-45"></span>
                    <span class="absolute left-0 bottom-1 h-px w-full bg-text-main transition-transform duration-300 group-aria-expanded:bottom-auto group-aria-expanded:top-1/2 group-aria-expanded:-rotate-45"></span>
                </button>
            </div>
        </header>

        <!-- Mobile menu: outside <header> because its backdrop-blur would trap position:fixed.
             Visibility flips instantly on open (focusable at once) and is delayed on close (fade-out stays visible). -->
        <div
            id="mobile-menu"
            class="md:hidden fixed inset-0 z-40 bg-base-50/95 backdrop-blur-md flex flex-col items-center justify-center gap-10 invisible opacity-0 transition-[opacity,visibility] duration-500 data-open:visible data-open:opacity-100 data-open:transition-opacity"
            inert
        >
            <nav class="flex flex-col items-center gap-8" aria-label={menuLabels.nav}>
                {navLinks.map(link => (
                    <a
                        href={link.href}
                        aria-current={isActive(link.href) ? 'page' : undefined}
                        class={`text-lg font-bold uppercase tracking-[0.3em] transition-colors ${
                            isActive(link.href) ? 'text-accent-500' : 'text-text-main hover:text-accent-500'
                        }`}
                    >
                        {link.label}
                    </a>
                ))}
            </nav>
            <div class="h-px w-12 bg-accent-500"></div>
            <p class="text-[10px] text-text-muted uppercase tracking-[0.3em]">Green people network</p>
        </div>

        <div transition:animate="fade">
            <slot />
        </div>

        <footer class="py-12 border-t border-base-200 text-center text-text-muted text-[10px] uppercase tracking-widest bg-base-100">
            <img src="/brand/naturalia-mark.svg" alt="" width="218" height="276" class="h-10 w-auto mx-auto mb-6" />
            <p class="mb-2">Naturalia srl &middot; Via Luciano Manara 17, 20212 Milano</p>
            <p>&copy; 2026 Naturalia srl. {text.vat} 03350540963</p>
        </footer>

        <script>
            // Campaign attribution without cookies or storage: read the landing URL once and keep it in memory.
            // The ClientRouter keeps `window` across page navigations, so it reaches the contact form;
            // a full reload or a new tab starts a new visit.
            const campaignKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'ttclid'];
            if (!window.msAttribution) {
                const params = new URLSearchParams(location.search);
                const attribution: Record<string, string> = { landing_page: location.pathname };
                if (document.referrer) {
                    const referrer = new URL(document.referrer).hostname;
                    if (referrer !== location.hostname) attribution.referrer = referrer;
                }
                for (const key of campaignKeys) {
                    const value = params.get(key);
                    if (value) attribution[key] = value.slice(0, 500);
                }
                window.msAttribution = attribution;
            }
        </script>

        <script>
            // Header and menu are re-rendered on every ClientRouter navigation:
            // bind on astro:page-load, and the new DOM always starts closed.
            // Global listeners are dropped on the next navigation via the abort signal.
            let controller: AbortController | undefined;

            function initMobileMenu() {
                controller?.abort();
                controller = new AbortController();
                const { signal } = controller;

                const toggle = document.getElementById('menu-toggle');
                const menu = document.getElementById('mobile-menu');
                if (!toggle || !menu) return;

                const setOpen = (open: boolean) => {
                    toggle.setAttribute('aria-expanded', String(open));
                    toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
                    menu.toggleAttribute('data-open', open);
                    menu.inert = !open;
                    document.documentElement.classList.toggle('overflow-hidden', open);
                    if (open) menu.querySelector('a')?.focus();
                };

                setOpen(false);
                toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
                menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && menu.hasAttribute('data-open')) { setOpen(false); toggle.focus(); }
                }, { signal });
                // Menu is md:hidden: release the scroll lock if the viewport grows past it
                matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); }, { signal });
            }

            document.addEventListener('astro:page-load', initMobileMenu);
        </script>
	</body>
</html>